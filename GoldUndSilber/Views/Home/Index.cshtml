@{
	ViewData["Title"] = "Preisabfrage";
}

<section class="hero">
	<div class="eyebrow">Edelmetalle · Preisabfrage</div>
	<h1>Der Wert von <em>Gold &amp; Silber</em>, auf den Gramm genau.</h1>
	<p>Gib ein Gewicht ein und erhalte sofort den aktuellen Preis für Gold oder Silber.</p>
</section>

<section class="metal-grid">
	<a class="metal-card" data-metal="gold" asp-controller="Gold" asp-action="Index">
		<img src="~/Images/DALL·E 2023-01-16 13.41.48 - 3d photorealistic gold bar with golden background.png" alt="Goldbarren" style="object-position:50% 60%" />
		<div class="body"><h2>Gold</h2><span class="cta">Goldpreis abfragen →</span></div>
	</a>
	<a class="metal-card" data-metal="silver" asp-controller="Silber" asp-action="Index">
		<img src="~/Images/DALL·E 2023-01-16 13.42.25 - 3d photorealistic silver bar with silver background.png" alt="Silberbarren" />
		<div class="body"><h2>Silber</h2><span class="cta">Silberpreis abfragen →</span></div>
	</a>
</section>
