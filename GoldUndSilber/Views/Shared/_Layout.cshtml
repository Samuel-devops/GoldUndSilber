<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Gold und Silber</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GoldUndSilber.styles.css" asp-append-version="true" />
</head>
<body data-metal="@ViewData["Metal"]">
    <header class="site-nav">
        <div class="container inner">
            <a class="brand" asp-controller="Home" asp-action="Index">Gold <span>&amp;</span> Silber</a>
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Start</a></li>
                <li><a asp-controller="Gold" asp-action="Index">Gold</a></li>
                <li><a asp-controller="Silber" asp-action="Index">Silber</a></li>
            </ul>
        </div>
    </header>
    <main role="main" class="container">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">&copy; @DateTime.Now.Year Gold und Silber</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
