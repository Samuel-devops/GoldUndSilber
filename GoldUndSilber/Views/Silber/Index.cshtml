@model SilberModel
@{
	ViewData["Title"] = "Silberpreis";
	ViewData["Metal"] = "silver";
}

<form class="calc" asp-controller="Silber" asp-action="GetSilverPrice" method="post">
	<div class="eyebrow" style="color:var(--accent)">Preisabfrage</div>
	<h2>Silberpreis</h2>
	<label for="txtGrams">Gewicht in Gramm</label>
	<input type="text" id="txtGrams" name="Grams" inputmode="decimal" placeholder="z. B. 31,1" autocomplete="off" value="@(Model.Grams > 0 ? Model.Grams.ToString() : "")" />
	<div class="result" aria-live="polite">
		<span style="color:var(--muted)">Preis</span>
		<span class="amount" id="lblPrice">@Model.Price €</span>
	</div>
	<button class="btn-metal" type="submit" id="btnGetPrice">Preis abrufen</button>
	<a class="back" asp-controller="Home" asp-action="Index">← Zurück</a>
</form>
